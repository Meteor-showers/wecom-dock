WECOM_BOT_ID=
WECOM_SECRET=
# 能执行更新的 userid，逗号分隔。留空则任何能给机器人发消息的人都能更新容器。
WECOM_ADMINS=
# 每天这个钟点检查，时区看 TZ。填写后不再按 CHECK_INTERVAL 循环。
CHECK_AT=10:30
# CHECK_INTERVAL=30m
TZ=Asia/Shanghai
# 国内查 Docker Hub 时填写这台服务器能访问到的代理。容器里的 127.0.0.1 不是宿主机。
# 这里只影响查版本。真正拉取镜像走宿主机 Docker，还要给 Docker 引擎配代理或镜像加速。
# HTTP_PROXY=http://192.168.1.10:7897
# HTTPS_PROXY=http://192.168.1.10:7897
# NO_PROXY=localhost,127.0.0.1
